{
  "extends": "@rodrigosantosdev/typescript-config/base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@rodrigosantosdev/saudade/*": ["./*"]
    }
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "fonts/index.ts"
  ],
  "exclude": ["node_modules"]
}
